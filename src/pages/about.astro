---
import Base from '../layouts/Base.astro';
import site from '../lib/site';
---
<Base title="About" description={`Education, experience and skills: ${site.name}, Mechatronics Engineering at Western University.`}>
  <h1>About</h1>
  <p class="lede">{site.intro} {site.seeking}</p>
  <p><a href={site.resume}>Resume (PDF)</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>

  <h2 class="label">Education</h2>
  {site.education.map((e) => (
    <div class="entry">
      <div class="head">
        <h3>{e.school}</h3>
        <span class="meta muted">{e.dates}</span>
      </div>
      <p class="sub">{e.degree}<span class="muted"> · {e.location}</span></p>
      {e.awards?.length > 0 && (
        <p class="awards"><span class="meta muted">Awards</span> {e.awards.join(' · ')}</p>
      )}
      {e.notes && <p>{e.notes}</p>}
    </div>
  ))}

  <h2 class="label">Relevant coursework</h2>
  {site.coursework.length
    ? <ul class="courses">{site.coursework.map((c) => <li>{c}</li>)}</ul>
    : <p class="todo">TODO: list relevant courses (e.g. course code and name). Edit in /admin → Site settings → About.</p>}

  <h2 class="label">Experience</h2>
  {site.experience.map((x) => (
    <div class="entry">
      <div class="head">
        <h3>{x.role}</h3>
        <span class="meta muted">{x.dates}</span>
      </div>
      <p class="sub">{x.org}<span class="muted"> · {x.location}</span></p>
      {x.bullets.length > 0 && <ul>{x.bullets.map((b) => <li>{b}</li>)}</ul>}
    </div>
  ))}

  <h2 class="label">Skills</h2>
  <dl class="skills">
    {site.skills.map((s) => (<><dt>{s.group}</dt><dd>{s.items}</dd></>))}
  </dl>
</Base>

<style>
  .lede { max-width: var(--measure); }
  .entry { margin-bottom: 1.75rem; max-width: var(--measure); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 1rem; }
  .entry h3 { margin: 0; font-size: var(--step-0); }
  .sub { margin: 0 0 0.4rem; }
  .awards { margin: 0.2rem 0 0; }
  .awards .meta { margin-right: 0.5rem; }
  .entry ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
  .entry li + li { margin-top: 0.2rem; }
  .courses { columns: 2 16rem; padding-left: 1.2rem; }
  .skills { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem; margin: 0; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; gap: 0.1rem; }
    .skills dd { margin-bottom: 0.6rem; }
  }
</style>
