---
import type { Project } from '../lib/projects';
import { shortDate, isoDate } from '../lib/format';
interface Props { projects: Project[] }
const { projects } = Astro.props;
---
<div class="table-wrap">
  <table class="projects">
    <caption class="visually-hidden">All projects, newest first</caption>
    <thead>
      <tr><th scope="col">Date</th><th scope="col">Project</th><th scope="col">Tags</th></tr>
    </thead>
    <tbody>
      {projects.map((p) => (
        <tr>
          <td class="date"><time datetime={isoDate(p.data.date)}>{shortDate(p.data.date)}</time></td>
          <td>
            <a href={`/projects/${p.id}/`}>{p.data.title}</a>{p.data.draft && <span class="mono muted"> (draft)</span>}
            <span class="summary">{p.data.summary}</span>
          </td>
          <td class="tags-cell mono muted">{p.data.tags.join(', ')}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .projects { width: 100%; border-collapse: collapse; }
  th {
    text-align: left; font-family: var(--font-mono); font-size: var(--step--1); font-weight: 400;
    color: var(--text-muted); padding: 0 1rem 0.4rem 0; border-bottom: 1px solid var(--rule);
  }
  td { vertical-align: baseline; padding: 0.7rem 1rem 0.7rem 0; border-bottom: 1px solid var(--rule); }
  td:last-child, th:last-child { padding-right: 0; }
  .date { white-space: nowrap; font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-muted); }
  .summary { display: block; font-size: 0.95em; color: var(--text-muted); line-height: 1.45; margin-top: 0.15rem; }
  .tags-cell { width: 28%; line-height: 1.5; }
  @media (max-width: 560px) {
    thead { display: none; }
    tr { display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--rule); }
    td { padding: 0; border: 0; }
    .tags-cell { grid-column: 2; width: auto; margin-top: 0.3rem; }
  }
</style>
